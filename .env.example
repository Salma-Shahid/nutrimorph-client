EXPO_PUBLIC_PADDLE_CLIENT_TOKEN=
EXPO_PUBLIC_PADDLE_MONTHLY_PRICE_ID=
EXPO_PUBLIC_PADDLE_YEARLY_PRICE_ID=
EXPO_PUBLIC_PADDLE_ENV=sandbox

# Required by the app for API calls; use your deployed backend or local URL.
EXPO_PUBLIC_API_URL=

# RevenueCat (primary in-app subscriptions). PUBLIC SDK keys only:
# RevenueCat > Project settings > API keys > App-specific keys (goog_... / appl_...).
# Also set these as EAS environment variables for preview/production builds.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Must match REVENUECAT_ENTITLEMENT_ID on the backend.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=nutrimorph_pro
