{
  "expo": {
    "name": "NutriMorph",
    "slug": "nutrimorph",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutrimorph.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "package": "com.nutrimorph.app",
      "googleServicesFile": "./google-services.json",
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "multidexEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-3940256099942544~3347511713"
      }
    },
    "web": {
      "favicon": "./assets/favicon.favicon"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NutriMorph to access your camera to scan meals and analyze food photos for AI nutrition tracking."
        }
      ],
      "expo-web-browser",
      "expo-image-picker",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "extra": {
      "eas": {
        "projectId": "d58feced-f2de-481d-a434-721e62ede0d0"
      }
    }
  }
}
